#!/bin/bash
# Honey Badger OS - System Update Utility
# This script updates the system and all packages with Honey Badger branding

set -euo pipefail

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly NC='\033[0m'

# Logging
readonly LOG_FILE="/tmp/honey-badger-update.log"

# Logging functions
log_info() {
    echo -e "${CYAN}[INFO]${NC} $1" | tee -a "$LOG_FILE"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1" | tee -a "$LOG_FILE"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG_FILE"
}

log_step() {
    echo -e "${BLUE}${BOLD}[STEP]${NC} $1" | tee -a "$LOG_FILE"
}

# Show banner
show_banner() {
    echo -e "${YELLOW}${BOLD}" | tee -a "$LOG_FILE"
    echo "  🦡 ================================================== 🦡" | tee -a "$LOG_FILE"
    echo "              HONEY BADGER OS UPDATER" | tee -a "$LOG_FILE"
    echo "            Fearless System Maintenance" | tee -a "$LOG_FILE"
    echo "  🦡 ================================================== 🦡" | tee -a "$LOG_FILE"
    echo -e "${NC}" | tee -a "$LOG_FILE"
}

# Detect package manager
detect_package_manager() {
    if command -v pacman >/dev/null 2>&1; then
        echo "pacman"
    elif command -v apt >/dev/null 2>&1; then
        echo "apt"
    elif command -v dnf >/dev/null 2>&1; then
        echo "dnf"
    elif command -v yum >/dev/null 2>&1; then
        echo "yum"
    elif command -v xbps-install >/dev/null 2>&1; then
        echo "xbps"
    elif command -v slackpkg >/dev/null 2>&1; then
        echo "slackpkg"
    else
        echo "unknown"
    fi
}

# Update system packages
update_system_packages() {
    local pm="$1"
    
    log_step "Updating system packages using $pm..."
    
    case "$pm" in
        pacman)
            log_info "Updating Arch Linux packages..."
            sudo pacman -Syu --noconfirm
            
            # Update AUR packages if yay is installed
            if command -v yay >/dev/null 2>&1; then
                log_info "Updating AUR packages..."
                yay -Sua --noconfirm || log_error "AUR update failed (continuing...)"
            fi
            ;;
        apt)
            log_info "Updating Debian/Ubuntu packages..."
            sudo apt update
            sudo apt upgrade -y
            sudo apt autoremove -y
            sudo apt autoclean
            ;;
        dnf)
            log_info "Updating Fedora packages..."
            sudo dnf upgrade -y
            sudo dnf autoremove -y
            ;;
        yum)
            log_info "Updating RHEL/CentOS packages..."
            sudo yum update -y
            sudo yum autoremove -y
            ;;
        xbps)
            log_info "Updating Void Linux packages..."
            sudo xbps-install -Su
            sudo xbps-remove -Oo
            ;;
        slackpkg)
            log_info "Updating Slackware packages..."
            sudo slackpkg update
            sudo slackpkg upgrade-all
            ;;
        *)
            log_error "Unknown package manager: $pm"
            return 1
            ;;
    esac
}

# Update Flatpak packages
update_flatpak() {
    if command -v flatpak >/dev/null 2>&1; then
        log_step "Updating Flatpak packages..."
        flatpak update -y || log_error "Flatpak update failed (continuing...)"
    fi
}

# Update Snap packages
update_snap() {
    if command -v snap >/dev/null 2>&1; then
        log_step "Updating Snap packages..."
        sudo snap refresh || log_error "Snap update failed (continuing...)"
    fi
}

# Update development tools
update_dev_tools() {
    log_step "Updating development tools..."
    
    # Update npm packages globally
    if command -v npm >/dev/null 2>&1; then
        log_info "Updating global npm packages..."
        npm update -g || log_error "npm global update failed (continuing...)"
    fi
    
    # Update pip packages
    if command -v pip3 >/dev/null 2>&1; then
        log_info "Updating pip packages..."
        pip3 list --outdated --format=freeze | grep -v '^\-e' | cut -d = -f 1 | xargs -n1 pip3 install -U || log_error "pip update failed (continuing...)"
    fi
    
    # Update Rust toolchain
    if command -v rustup >/dev/null 2>&1; then
        log_info "Updating Rust toolchain..."
        rustup update || log_error "Rust update failed (continuing...)"
    fi
    
    # Update Go tools (if GOPATH is set)
    if command -v go >/dev/null 2>&1 && [[ -n "${GOPATH:-}" ]]; then
        log_info "Updating Go tools..."
        # This is a simplified update - in practice you'd want to track installed tools
        log_info "Go tools update requires manual intervention"
    fi
}

# Update firmware (if fwupd is available)
update_firmware() {
    if command -v fwupdmgr >/dev/null 2>&1; then
        log_step "Checking for firmware updates..."
        fwupdmgr refresh || true
        fwupdmgr get-updates || log_info "No firmware updates available"
    fi
}

# Clean up system
cleanup_system() {
    log_step "Performing system cleanup..."
    
    # Clean package manager caches
    local pm=$(detect_package_manager)
    case "$pm" in
        pacman)
            sudo pacman -Sc --noconfirm
            ;;
        apt)
            sudo apt autoremove -y
            sudo apt autoclean
            ;;
        dnf)
            sudo dnf clean all
            ;;
        yum)
            sudo yum clean all
            ;;
        xbps)
            sudo xbps-remove -Oo
            ;;
    esac
    
    # Clean temporary files
    log_info "Cleaning temporary files..."
    sudo rm -rf /tmp/* 2>/dev/null || true
    
    # Clean user cache (be careful)
    if [[ -d "$HOME/.cache" ]]; then
        log_info "Cleaning user cache..."
        find "$HOME/.cache" -type f -atime +30 -delete 2>/dev/null || true
    fi
}

# Show update summary
show_summary() {
    log_success "System update completed!"
    echo
    echo -e "${BOLD}${GREEN}🦡 Update Summary 🦡${NC}"
    echo -e "${CYAN}Date:${NC} $(date)"
    echo -e "${CYAN}Log:${NC} $LOG_FILE"
    echo
    echo -e "${YELLOW}Like the honey badger, your system is now fearlessly up to date! 🦡${NC}"
    echo
    echo -e "${CYAN}Next steps:${NC}"
    echo "• Run 'honey-badger-info' to check system status"
    echo "• Reboot if kernel updates were installed"
    echo "• Check the log file if any errors occurred"
}

# Check for root
check_privileges() {
    if [[ $EUID -eq 0 ]]; then
        log_error "This script should not be run as root!"
        log_info "Please run as a regular user with sudo privileges."
        exit 1
    fi
    
    # Test sudo access
    if ! sudo -n true 2>/dev/null; then
        log_info "Testing sudo access..."
        if ! sudo true; then
            log_error "This script requires sudo privileges."
            exit 1
        fi
    fi
}

# Main function
main() {
    # Setup logging
    echo "Honey Badger OS Update Log - $(date)" > "$LOG_FILE"
    
    show_banner
    check_privileges
    
    local pm=$(detect_package_manager)
    if [[ "$pm" == "unknown" ]]; then
        log_error "No supported package manager found!"
        log_info "Supported: pacman, apt, dnf, yum, xbps, slackpkg"
        exit 1
    fi
    
    log_info "Detected package manager: $pm"
    
    # Parse command line options
    local update_all=true
    local update_system=true
    local update_flatpak=true
    local update_snap=true
    local update_dev=true
    local cleanup=true
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --system-only)
                update_flatpak=false
                update_snap=false
                update_dev=false
                ;;
            --no-cleanup)
                cleanup=false
                ;;
            --dev-only)
                update_system=false
                update_flatpak=false
                update_snap=false
                ;;
            --help|-h)
                echo "Honey Badger OS System Updater"
                echo
                echo "Usage: $0 [options]"
                echo
                echo "Options:"
                echo "  --system-only    Update only system packages"
                echo "  --dev-only       Update only development tools"
                echo "  --no-cleanup     Skip cleanup phase"
                echo "  --help, -h       Show this help message"
                echo
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                exit 1
                ;;
        esac
        shift
    done
    
    # Perform updates
    if $update_system; then
        update_system_packages "$pm"
    fi
    
    if $update_flatpak; then
        update_flatpak
    fi
    
    if $update_snap; then
        update_snap
    fi
    
    if $update_dev; then
        update_dev_tools
    fi
    
    update_firmware
    
    if $cleanup; then
        cleanup_system
    fi
    
    show_summary
}

# Handle interruption
trap 'echo -e "\n${RED}Update interrupted by user${NC}"; exit 1' INT TERM

# Run if executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi