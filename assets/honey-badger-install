#!/bin/bash
# Honey Badger OS - Package Install Helper
# This is a fallback version; the live version is generated at install time in ~/.local/bin/

set -euo pipefail

NC='\033[0m'; BOLD='\033[1m'; YELLOW='\033[0;33m'; GREEN='\033[0;32m'; RED='\033[0;31m'; CYAN='\033[0;36m'

if [[ $# -eq 0 ]] || [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    echo -e "${YELLOW}${BOLD}🦡 Honey Badger OS - Package Installer${NC}"
    echo ""
    echo "Usage: honey-badger-install <package1> [package2] ..."
    echo ""
    echo "Examples:"
    echo "  honey-badger-install vim"
    echo "  honey-badger-install firefox vlc gimp"
    [[ $# -eq 0 ]] && exit 1
    exit 0
fi

# Validate package names (alphanumeric, hyphens, dots, underscores, plus signs, colons)
for arg in "$@"; do
    if [[ ! "$arg" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+:-]*$ ]]; then
        echo -e "${RED}Invalid package name: $arg${NC}"
        echo "Package names may only contain: letters, digits, dots, hyphens, underscores, plus signs"
        exit 1
    fi
done

echo -e "${YELLOW}${BOLD}🦡 Installing: $*${NC}\n"

# Detect package manager and install
if command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --noconfirm "$@"
elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get install -y "$@"
elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y "$@"
elif command -v yum >/dev/null 2>&1; then
    sudo yum install -y "$@"
elif command -v xbps-install >/dev/null 2>&1; then
    sudo xbps-install -y "$@"
elif command -v slackpkg >/dev/null 2>&1; then
    for pkg in "$@"; do sudo slackpkg install "$pkg"; done
else
    echo -e "${RED}No supported package manager found${NC}"
    exit 1
fi

echo -e "\n${GREEN}${BOLD}Installation complete! 🦡${NC}"
